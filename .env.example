# ========================================================
# INSTROOM SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your environment values
# ========================================================

# Database Configuration
DB_HOSTNAME=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=armful_db

# Security & Session Keys
ENCRYPTION_KEY=replace_with_32_character_random_string
CRON_KEY=replace_with_secure_cron_key

# SMTP / Email Configuration
SMTP_PROTOCOL=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_CRYPTO=tls

# Google OAuth (Gmail API Integration)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Social Media & Discovery APIs
YOUTUBE_API_KEY=your_youtube_api_key
DISCOVERY_ALLOW_MOCK=false
FACEBOOK_APP_ID=your_fb_app_id
FACEBOOK_APP_SECRET=your_fb_app_secret
FACEBOOK_ACCESS_TOKEN=your_fb_access_token
IG_BUSINESS_ACCOUNT_ID=your_ig_business_id
AYRSHARE_API_KEY=your_ayrshare_key
RAPIDAPI_KEY=your_rapidapi_key
ZOCIALMINE_API_KEY=your_zocialmine_key
APIFY_API_TOKEN=your_apify_token

# E-commerce (Shopify Integration)
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token
SHOPIFY_STORE_URL=your-store.myshopify.com
